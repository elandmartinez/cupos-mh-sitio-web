---
import '../styles/theme.css'; // Shared design tokens (colors, radii, shadows)

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content="Gestión de cupos, compras y pagos de clientes." />
		<!-- Blends the mobile browser chrome with the page background
		     (--color-surface-subtle, see theme.css). -->
		<meta name="theme-color" content="#f8fafc" />
		<meta name="color-scheme" content="light" />
		<!-- Outfit is the one typeface (see DESIGN.md); system fonts are the
		     fallback when the network is unavailable. -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap"
		/>
	</head>
	<body>
		<a class="skipLink" href="#main">Saltar al contenido</a>
		<slot />
	</body>
</html>

<style>
	/* Everything global (margins, box-sizing, body background, color) is owned
	   by theme.css — this block only keeps the page from scrolling sideways. */
	html,
	body {
		width: 100%;
	}
</style>
