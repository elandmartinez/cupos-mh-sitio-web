---
import Layout from '../layouts/Layout.astro';
import es from '../i18n/locales/es';
---

<Layout title={es.meta.titleNotFound}>
  <main id="main" class="notFoundShell">
    <section class="emptyState notFoundCard" aria-labelledby="notFoundTitle">
      <p class="notFoundCode" aria-hidden="true">404</p>
      <h1 id="notFoundTitle" class="emptyStateTitle">No encontramos esta página</h1>
      <p class="emptyStateBody">
        Puede que el enlace esté roto o que la dirección esté mal escrita.
      </p>
      <div class="emptyStateAction">
        <a class="btnPrimary" href="/">Volver al inicio</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Centres the one card on the page background; the card itself reuses the
     shared `.emptyState` primitive (illustration → heading → body → one CTA). */
  .notFoundShell {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100dvh;
    padding: var(--space-24) var(--page-padding);
  }

  .notFoundCard {
    width: 100%;
    max-width: 30rem;
  }

  /* Decorative — the heading below carries the meaning for assistive tech. */
  .notFoundCode {
    margin: 0;
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-primary);
  }
</style>
