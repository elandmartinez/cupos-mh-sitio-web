# cupos-sitio-web - environment variables
# Copy this file to .env and fill in real values.
# Both values are inlined into the browser bundle at build time (PUBLIC_*),
# so use ONLY the publishable / anon key. Never put a service_role key here.
# On Vercel, set both for Production and Preview before building.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
PUBLIC_SUPABASE_URL=

# Supabase publishable / anon key
PUBLIC_SUPABASE_KEY=
